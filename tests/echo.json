{
  "openapi": "3.0.0",
  "info": {
    "title": "Echo API",
    "description": "Simple Rest Echo",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:8002/v1" }
  ],
  "paths": {
    "/ws/echo": {
      "x-websocket": true
    },
    "/echo": {
      "get": {
        "description": "Returns the 'message' to the caller",
        "operationId": "echo",
        "parameters": [
          {
            "name": "headerParam",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "message",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EchoResponse" }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "post": {
        "description": "Echoes back the posted EchoResponse",
        "operationId": "postEcho",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EchoResponse" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EchoResponse" }
              }
            }
          }
        }
      }
    },
    "/echo/{id}": {
      "get": {
        "description": "Returns echo with path param id",
        "operationId": "getEchoById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EchoResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "description": "Deletes echo by id",
        "operationId": "deleteEchoById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EchoResponse" }
              }
            }
          }
        }
      }
    },
    "/outcome": {
      "post": {
        "description": "Echo an outcome variant",
        "operationId": "postOutcome",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Outcome" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Outcome" }
              }
            }
          }
        }
      }
    },
    "/items/detailed": {
      "post": {
        "description": "Create a detailed item",
        "operationId": "createDetailedItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DetailedItem" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DetailedItem" }
              }
            }
          }
        }
      }
    },
    "/items/search": {
      "get": {
        "description": "Search items by category",
        "operationId": "searchItems",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EchoResponse" }
              }
            }
          }
        }
      }
    },
    "/items/{itemId}/tags/{tagIndex}": {
      "get": {
        "description": "Get a specific tag of an item",
        "operationId": "getItemTag",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "tagIndex",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EchoResponse" }
              }
            }
          }
        }
      }
    },
    "/items/{id}": {
      "put": {
        "description": "Update an item by id",
        "operationId": "updateItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Item" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      }
    },
    "/items": {
      "get": {
        "description": "List items with optional filters",
        "operationId": "listItems",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      },
      "post": {
        "description": "Create a new item",
        "operationId": "createItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Item" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EchoResponse": {
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      },
      "Error": {
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "fields": { "type": "string" }
        }
      },
      "ItemStatus": {
        "type": "string",
        "enum": ["active", "inactive", "archived"]
      },
      "Item": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": { "$ref": "#/components/schemas/ItemStatus" }
        }
      },
      "DetailedItem": {
        "allOf": [
          { "$ref": "#/components/schemas/Item" },
          {
            "type": "object",
            "required": ["detail"],
            "properties": {
              "detail": { "type": "string" },
              "rating": { "type": "number", "format": "double" }
            }
          }
        ]
      },
      "Outcome": {
        "oneOf": [
          { "$ref": "#/components/schemas/Error" },
          { "$ref": "#/components/schemas/EchoResponse" }
        ]
      }
    }
  }
}
